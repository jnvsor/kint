<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="true"
    ensureOverrideAttribute="false"
    strictBinaryOperands="false"
>
    <enableExtensions>
        <!-- Reflection lies! -->
        <extension name="simplexml"/>
    </enableExtensions>

    <stubs>
        <file name="stubs/defines.phpstub" />
    </stubs>

    <projectFiles>
        <directory name="src" />
        <file name="init.php" />
        <file name="init_helpers.php" />
        <file name="init_phar.php" />
    </projectFiles>

    <issueHandlers>
        <ClassMustBeFinal errorLevel="info"/>
        <Trace errorLevel="error"/>

        <!-- Suppress include guarded PHP calls -->
        <UndefinedMethod>
            <errorLevel type="suppress">
                <referencedMethod name="ReflectionProperty::isFinal"/>
                <referencedMethod name="ReflectionProperty::isVirtual"/>
                <referencedMethod name="ReflectionProperty::getHooks"/>
                <referencedMethod name="ReflectionProperty::isProtectedSet"/>
                <referencedMethod name="ReflectionProperty::isPrivateSet"/>
                <referencedMethod name="ReflectionProperty::getSettableType"/>
            </errorLevel>
        </UndefinedMethod>
    </issueHandlers>
</psalm>
